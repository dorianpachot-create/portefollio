{
    "name": "dorianpachot/portefollio",
    "description": "Portfolio de Dorian Pachot, BTS SIO SLAM. Code source Symfony du site, exporté en HTML statique pour GitHub Pages.",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "symfony/console": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/ux-twig-component": "^2.28",
        "symfony/yaml": "7.4.*",
        "twig/twig": "^3.21"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "export": "php bin/console app:export",
        "serveur": "php -S 127.0.0.1:8000 -t .. public/index.php"
    }
}

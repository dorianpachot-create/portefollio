{# SECTION 02 : PARCOURS. Une étape par entrée de contenu/parcours.yaml #}
<section id="parcours" class="scroll-mt-16 py-20 md:py-28" aria-labelledby="parcours-title" data-rail-wrap>
  <div class="px-5 md:px-8"><div class="mx-auto max-w-6xl">
    <twig:EnTeteSection numero="02" rubrique="Parcours" titre="Mon parcours" idTitre="parcours-title">
      Un parcours qui n'est pas linéaire. Il se lit de gauche à droite : faites glisser ou utilisez les flèches.
      <twig:block name="aDroite">
        <div class="reveal flex items-center gap-4">
          {# Légende des couleurs de la frise #}
          <ul class="hidden gap-4 text-xs text-ash sm:flex">
            <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-blood"></span>Études et technique</li>
            <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-ash"></span>Emploi</li>
            <li class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-[#F97316]"></span>Sport</li>
          </ul>
          <button class="round-btn" type="button" data-rail-prev aria-label="Étape précédente"><twig:Icone nom="fleche-gauche" classe="" /></button>
          <button class="round-btn" type="button" data-rail-next aria-label="Étape suivante"><twig:Icone nom="fleche-droite" classe="" /></button>
        </div>
      </twig:block>
    </twig:EnTeteSection>
  </div></div>

  {# La frise : défile horizontalement (voir "Frise horizontale" dans js/accueil.js) #}
  <ol class="rail reveal mt-10 pb-2" data-rail tabindex="0" aria-label="Parcours de {{ parcours|first.periode|slice(0, 4) }} à aujourd'hui">
    {% for etape in parcours %}<twig:EtapeParcours :etape="etape" />{% endfor %}
  </ol>
  <div class="mt-6 px-5 md:px-8"><div class="mx-auto max-w-6xl"><div class="rail-progress" aria-hidden="true"><span data-rail-progress></span></div></div></div>
</section>

{#
  ACCUEIL : la page principale, découpée en sections.
  -----------------------------------------------------------------------------
  Chaque section est dans son propre fichier (accueil/_xxx.html.twig), dans
  l'ordre d'affichage. Pour déplacer une section, il suffit de déplacer sa
  ligne {% include %} ; pour en masquer une, mettre la ligne en commentaire.
  Les textes viennent des fichiers YAML du dossier contenu/.
#}
{% extends 'base.html.twig' %}

{% block titre %}Dorian Pachot, étudiant en BTS SIO, à la recherche d'une alternance{% endblock %}
{% block description %}Dorian Pachot, étudiant en deuxième année de BTS SIO SLAM à Rouen, motivé et à la recherche d'une alternance. Projets, méthode et parcours.{% endblock %}
{% block chemin %}{% endblock %}

{# Pastilles sur le côté droit (écrans larges), une par section #}
{% block avant_entete %}
  <nav class="scroll-dots" aria-label="Sections de la page" data-dots>
    {% for r in profil.reperes %}<a href="#{{ r.ancre }}" data-label="{{ r.texte }}"></a>{% endfor %}
  </nav>
{% endblock %}

{% block entete %}<twig:EnTete :accueil="true" />{% endblock %}

{% block contenu %}
  {% include 'accueil/_presentation.html.twig' %}    {# Présentation et bandeau   #}
  {% include 'accueil/_parcours.html.twig' %}        {# Parcours (frise)          #}
  {% include 'accueil/_realisations.html.twig' %}    {# Réalisations (projets)    #}
  {% include 'accueil/_cours.html.twig' %}           {# Projets encadrés (TP)     #}
  {% include 'accueil/_outils.html.twig' %}          {# Outils                    #}
  {% include 'accueil/_competences.html.twig' %}     {# Qualités et méthode       #}
  {% include 'accueil/_veille.html.twig' %}          {# Veille                    #}
  {% include 'accueil/_documents.html.twig' %}       {# Documents                 #}
  {% include 'accueil/_contact.html.twig' %}         {# Contact                   #}
{% endblock %}

{# L'accueil a son propre script (carte de profil, frise, filtre des projets, suivi de défilement) #}
{% block scripts %}<script src="js/accueil.js"></script>{% endblock %}

{#
  SECTION 06 : POINTS D'APPUI ET MÉTHODE. Textes : contenu/competences.yaml
  Quatre cartes (les qualités), puis "Ma méthode de travail".
#}
<section id="competences" class="scroll-mt-16 px-5 py-20 md:px-8 md:py-28" aria-labelledby="comp-title">
  <div class="mx-auto max-w-6xl">
    <twig:EnTeteSection rubrique="Points d'appui et méthode" titre="Ce sur quoi je peux m'appuyer" idTitre="comp-title">
      Pas de notes ni de niveaux : quatre qualités que je travaille, chacune illustrée par un exemple concret.
    </twig:EnTeteSection>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {% for q in competences.qualites %}
        <li class="panel reveal p-6">
          <h3 class="font-display text-lg font-bold text-bone">{{ q.nom }}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ash">{{ q.texte }}</p>
        </li>
      {% endfor %}
    </ul>

    <div class="mt-16">
      <h3 class="reveal font-display text-2xl font-bold tracking-tight text-bone">Ma méthode de travail</h3>
      <p class="reveal mt-2 max-w-xl text-sm text-ash">Héritée du sport collectif : préparer, exécuter, puis analyser.</p>
      <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {% for etape in competences.methode %}
          <li class="panel reveal p-6">
            <h4 class="font-display text-lg font-bold text-bone">{{ etape.titre }}</h4>
            <p class="mt-2 text-sm leading-relaxed text-ash">{{ etape.texte }}</p>
          </li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>

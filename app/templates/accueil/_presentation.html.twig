{# SECTION 01 : PRÉSENTATION. Textes : contenu/profil.yaml (presentation, carte_profil, bandeau) #}
{%- set p = profil.presentation -%}
{%- set carte = profil.carte_profil -%}
<section id="top-hero" class="px-5 pb-16 pt-28 md:px-8 md:pb-24 md:pt-36" aria-labelledby="hero-title">
  <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
    <div class="min-w-0">
      <p class="label reveal text-blood">{{ p.salut }}</p>
      <h1 id="hero-title" class="reveal mt-4 font-display text-[clamp(2.2rem,6vw,3.4rem)] font-bold leading-[1.08] tracking-[-.02em] text-bone">{{ p.titre }}</h1>
      <p class="reveal mt-2 text-lg text-ash md:text-xl">{{ p.sous_titre }}</p>
      <div class="reveal mt-7 max-w-xl space-y-4 text-base leading-relaxed text-ash">
        {% for paragraphe in p.paragraphes %}<p>{{ paragraphe }}</p>{% endfor %}
      </div>
      <div class="reveal mt-9 flex flex-col gap-3 sm:flex-row">
        <twig:Bouton texte="Me contacter" url="#contact" />
        <twig:Bouton texte="Voir les projets" url="#projets" style="secondaire" />
      </div>
    </div>

    {# Carte de profil : photo, trois infos et la jauge d'avancement du BTS. data-tilt : légère inclinaison à la souris #}
    <div class="reveal mx-auto w-full max-w-sm" style="perspective: 1000px">
      <article class="profile-card panel relative p-5" data-tilt aria-label="Fiche de profil">
        <span class="shine" aria-hidden="true"></span>
        <div class="relative aspect-[4/4.2] overflow-hidden rounded-[10px] bg-edge">
          <twig:Image :fichier="carte.photo" :alt="'Portrait de ' ~ profil.nom" classe="h-full w-full object-cover" :largeur="720" :hauteur="720" :lazy="false" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#090A0F]/85 via-transparent to-transparent"></div>
          <div class="absolute bottom-4 left-4 right-4">
            <p class="font-display text-2xl font-bold tracking-tight text-white">{{ profil.nom }}</p>
            <p class="text-sm text-white/80">{{ carte.legende }}</p>
          </div>
        </div>
        <dl class="mt-4 grid grid-cols-3 gap-2 text-center">
          {% for info in carte.infos %}
            <div class="rounded-lg border border-edge bg-void/40 px-2 py-2.5"><dt class="label !text-[.6rem] text-ash">{{ info.libelle }}</dt><dd class="mt-0.5 text-sm font-semibold text-bone">{{ info.valeur }}</dd></div>
          {% endfor %}
        </dl>
        <div class="mt-4">
          <div class="flex justify-between text-xs text-ash"><span>{{ carte.avancement_texte }}</span><span>{{ carte.avancement_valeur|raw }}</span></div>
          <div class="meter mt-2"><span data-w="{{ carte.avancement_pourcentage }}"></span></div>
        </div>
      </article>
    </div>
  </div>
</section>

{# Bandeau qui défile. La liste est écrite deux fois pour que la boucle soit continue. #}
<div class="ticker border-y border-edge bg-panel/50 py-3.5" aria-hidden="true">
  <div class="ticker__track text-sm font-medium text-ash">
    {% for i in 1..2 %}
      <div class="flex shrink-0 gap-10 pr-10">
        {% for phrase in profil.bandeau %}<span class="ticker__item">{{ phrase }}</span>{% endfor %}
      </div>
    {% endfor %}
  </div>
</div>

{# Composant CarteDocument : la vignette d'un document dans "Mon dossier" (accueil). #}
{% props document %}
<article class="project card-link panel reveal relative flex flex-col" style="--c:#EF4444">
  <div class="block overflow-hidden p-3 pb-0">
    <twig:Image :fichier="document.vignette" :alt="'Aperçu : ' ~ document.titre" classe="project__img aspect-[368/520] w-full rounded-t-lg object-cover object-top" :largeur="document.largeur" :hauteur="520" />
  </div>
  <div class="border-t border-edge p-5">
    <h3 class="font-display text-[15px] font-bold text-bone">{{ document.titre }}</h3>
    <p class="mt-0.5 text-xs text-ash">{{ document.sous_titre }}</p>
    <p class="mt-3 flex gap-4 text-sm font-semibold"><a class="stretch text-blood hover:text-bone" href="{{ lien(document.page) }}">Consulter</a><a class="text-ash hover:text-bone" href="{{ lien(document.pdf) }}" target="_blank" rel="noopener">PDF</a></p>
  </div>
</article>

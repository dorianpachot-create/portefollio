{# PAGE "DOCUMENTS" : lettre de recommandation, bulletin et lettre de motivation en grand. #}
{% extends 'base.html.twig' %}

{% block titre %}Documents | Dorian Pachot{% endblock %}
{% block description %}Lettre de recommandation, bulletin de première année et lettre de motivation de Dorian Pachot.{% endblock %}
{% block chemin %}pages/documents.html{% endblock %}
{% block entete %}<twig:EnTete actif="Documents" />{% endblock %}

{% block contenu %}
  <twig:EnTetePage cadre="Documents" titre="Mon dossier" retourUrl="index.html#documents" retourTexte="Retour à l'accueil">
    <p>Lettre de recommandation, bulletin de première année et lettre de motivation. Le CV a <a class="text-blood underline" href="{{ lien('pages/cv.html') }}">sa propre page</a>.</p>
  </twig:EnTetePage>

  <div class="px-5 pb-16 md:px-8"><div class="mx-auto grid max-w-4xl gap-5">
    <twig:Panneau id="reco" titre="Lettre de recommandation de Suitime">
      <p>Écrite par Valentin Javelaud après mon stage, du 6 juillet au 7 août 2026, sur SYNCRO.</p>
      <twig:DocumentApercu image="assets/recommandation/reco.png"
        alt="Lettre de recommandation de Suitime du 20 juillet 2026. Signature retirée pour la version en ligne."
        note="Suitime, 20 juillet 2026. Signature retirée pour la mise en ligne, original disponible sur demande."
        pdf="assets/recommandation/Lettre_recommandation_Suitime.pdf" nomFichier="Lettre_recommandation_Suitime_Dorian_Pachot.pdf"
        bouton="Télécharger la lettre" :principal="true" />
    </twig:Panneau>
    <twig:Panneau id="bulletin" titre="Bulletin de première année">
      <p>Année 2025-2026 à IRIS MediaSchool, campus de Rouen.</p>
      <twig:DocumentApercu image="assets/bulletin/bulletin.png"
        alt="Bulletin de première année de BTS SIO 2025-2026. Date de naissance et signature retirées."
        note="22 juin 2026. Date de naissance et signature retirées pour la mise en ligne."
        pdf="assets/bulletin/Bulletin_1ere_annee_Dorian_Pachot.pdf" nomFichier="Bulletin_1ere_annee_Dorian_Pachot.pdf"
        bouton="Télécharger le bulletin" />
    </twig:Panneau>
    <twig:Panneau id="lm" titre="Lettre de motivation">
      <p>Une lettre de base pour ma recherche d'alternance, que j'adapte à chaque entreprise.</p>
      <twig:DocumentApercu image="assets/lettre-motivation/lm.png" alt="Lettre de motivation de Dorian Pachot." note="Version de base."
        pdf="assets/lettre-motivation/LM_Dorian_Pachot.pdf" nomFichier="LM_Dorian_Pachot.pdf" bouton="Télécharger la lettre" />
    </twig:Panneau>
  </div></div>
{% endblock %}

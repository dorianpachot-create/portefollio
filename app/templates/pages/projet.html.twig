{#
  PAGE PROJET : une seule mise en page pour les quatre projets.
  Le contrôleur (PageController::projet) lui passe le projet demandé, lu dans
  contenu/projets.yaml. Pour modifier un texte : c'est dans ce fichier YAML.
#}
{% extends 'base.html.twig' %}

{% block titre %}{{ projet.titre_page }}{% endblock %}
{% block description %}{{ projet.description }}{% endblock %}
{% block chemin %}pages/{{ projet.slug }}.html{% endblock %}
{% block entete %}<twig:EnTete actif="Projets" />{% endblock %}

{% block contenu %}
  {# Titre : la première lettre prend la couleur du projet #}
  {% set titre = '<span style="color:' ~ projet.couleur ~ '">' ~ projet.nom|first ~ '</span>' ~ projet.nom|slice(1) %}
  <twig:EnTetePage :cadre="projet.cadre" :titre="titre">
    <p>{{ projet.intro|raw }}</p>
    <twig:block name="extra">
      <div class="mt-7 flex flex-wrap gap-2.5">
        {% for l in projet.liens %}
          <twig:Bouton :texte="l.texte" :url="l.url" :style="l.style" :petit="true" :icone="l.icone ?? null" />
        {% endfor %}
      </div>
    </twig:block>
  </twig:EnTetePage>

  <div class="px-5 pb-6 md:px-8"><div class="mx-auto max-w-6xl"><twig:MediaProjet :media="projet.media" /></div></div>

  <div class="px-5 pb-16 pt-6 md:px-8">
    <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[1fr_18rem]">
      <div class="grid min-w-0 gap-5">
        {% for section in projet.sections %}
          <twig:SectionProjet :section="section" />
        {% endfor %}
      </div>
      <twig:FicheProjet :projet="projet" />
    </div>
  </div>

  <twig:AppelContact />
{% endblock %}
